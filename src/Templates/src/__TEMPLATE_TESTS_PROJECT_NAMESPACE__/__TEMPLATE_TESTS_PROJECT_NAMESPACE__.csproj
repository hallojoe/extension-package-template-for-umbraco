<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <CoverletExclude>[__TEMPLATE_PROJECTS_NAMESPACE__.TestSite]*</CoverletExclude>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Include="NSubstitute" Version="5.1.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="Umbraco.Cms.Tests.Integration" Version="__TEMPLATE_UMBRACO_VERSION__" />
    <PackageReference Include="coverlet.msbuild" Version="6.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\__TEMPLATE_PROJECTS_NAMESPACE__\__TEMPLATE_PROJECTS_NAMESPACE__.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="appsettings.Tests.Local.json" CopyToOutputDirectory="Always" />
    <None Include="appsettings.Tests.json" CopyToOutputDirectory="Always" />
  </ItemGroup>

  <Target Name="CopyUmbracoIntegrationDeps" AfterTargets="Build">
    <Copy
      SourceFiles="$(OutputPath)$(AssemblyName).deps.json"
      DestinationFiles="$(OutputPath)Umbraco.Tests.Integration.deps.json"
      SkipUnchangedFiles="true"
      Condition="Exists('$(OutputPath)$(AssemblyName).deps.json')" />
  </Target>

  <Target Name="CreateTestTempDirectories" BeforeTargets="Build">
    <MakeDir Directories="$(ProjectDir)TEMP" />
    <MakeDir Directories="$(ProjectDir)TEMP\media" />
    <MakeDir Directories="$(ProjectDir)TEMP\cache" />
    <MakeDir Directories="$(ProjectDir)TEMP\logs" />
    <MakeDir Directories="$(ProjectDir)TEMP\databases" />
  </Target>

</Project>
